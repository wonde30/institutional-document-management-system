APP_NAME="Wollo University DMS"
APP_ENV=local
# APP_KEY is also used to encrypt PKI CA & user private keys at rest via Laravel Crypt (AES-256-CBC + HMAC-SHA256)
APP_KEY=
# APP_KEY is used by Laravel's Crypt facade (AES-256-CBC) for all application-level
# encryption, INCLUDING the PKI private keys stored at rest in storage/app/pki/.
# Private key files are encrypted with Crypt::encryptString() before writing to disk
# and decrypted with Crypt::decryptString() before use.  Never share or commit APP_KEY.
# After rotating APP_KEY you MUST re-run: php artisan pki:encrypt-keys-at-rest
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wollo_dms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Object storage (only used when FILESYSTEM_DISK=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
QUEUE_CONNECTION=database

CACHE_STORE=log

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@wollo.edu.et"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
