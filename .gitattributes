# Normalize text files to LF in the repository, check out with native endings.
* text=auto eol=lf

# Windows-native scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Keep binary assets untouched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp4 binary
*.pdf binary

# Lockfiles: keep LF for reproducible diffs
package-lock.json text eol=lf
composer.lock text eol=lf

# GitHub / VCS metadata
.gitattributes text eol=lf
.gitignore text eol=lf
