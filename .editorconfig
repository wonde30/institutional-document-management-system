root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,ts,vue,json,css,scss,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.{png,jpg,jpeg,gif,ico,webp,pdf,woff,woff2,ttf,eot}]
insert_final_newline = false
trim_trailing_whitespace = false
